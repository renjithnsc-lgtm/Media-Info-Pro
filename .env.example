# ============================================
# MediaInfo Pro - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=3000

# MySQL Database (Primary)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mediainfo_pro

# SQLite Fallback (auto-created if MySQL is down)
SQLITE_PATH=./airone.db

# Authentication
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here

